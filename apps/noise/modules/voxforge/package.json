{
  "name": "voxforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "test:e2e:ci": "cypress run --headless --browser chrome",
    "test:performance": "jest --testMatch=\"**/*.perf.test.[jt]s?(x)\"",
    "test:unit": "jest --testPathPattern=\"/(unit|spec)\"",
    "test:integration": "jest --testPathPattern=\"integration\"",
    "test:component": "jest --testPathPattern=\"component\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@pixi/graphics-extras": "^7.4.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@tonejs/midi": "^2.0.28",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "immer": "^10.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "openai": "^6.39.1",
    "pitchfinder": "^2.3.2",
    "pixi.js": "^8.14.0",
    "qs": "^6.15.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "realtime-bpm-analyzer": "^4.0.2",
    "tailwind-merge": "^3.4.0",
    "tmp": "^0.2.7",
    "tonal": "^6.4.2",
    "tone": "^15.1.22",
    "uuid": "^14.0.0",
    "ws": "^8.20.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/gsap": "^1.20.2",
    "@types/jest": "^29.5.12",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/sinon": "^21.0.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.16.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-jest": "^27.6.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.10",
    "sinon": "^17.0.1",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3",
    "web-audio-mock-api": "^1.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "qs": "$qs",
    "uuid": "$uuid"
  }
}
