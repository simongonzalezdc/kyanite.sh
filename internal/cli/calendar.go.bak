var calendarCmd = &cobra.Command{
	Use:   "calendar [month|week|day]",
	Short: "📅 Show calendar with task deadlines",
	Long: `Display calendar with task deadlines, events, and scheduling information.
Views:
  - month: Full month view with task indicators
  - week: Detailed week view
  - day: Single day with full details`,
	Args: cobra.MaximumNArgs(1),
	Run: func(cmd *cobra.Command, args []string) {
		viewMode := "month"
		if len(args) > 0 {
			viewMode = args[0]
		}

		// Initialize calendar with existing tasks
		cal := calendar.New()
		loadTasksIntoCalendar(cal)

		// Show calendar status
		status := utils.CheckAIStatus()
		fmt.Print("AI Status: ")
		utils.StreamStatusWithIndicator(status)
		fmt.Println()

		// Render calendar based on view mode
		renderer := calendar.NewRenderer(styles.GetTheme())
		
		switch viewMode {
		case "week":
			fmt.Println(renderer.RenderWeek(cal))
		case "day":
			fmt.Println(renderer.RenderDay(cal))
		default:
			fmt.Println(renderer.RenderMonth(cal))
		}
	},
}

var scheduleCmd = &cobra.Command{
	Use:   "schedule \"task description\" [date]",
	Short: "📅 Schedule task for specific date",
	Long: `Schedule a task for a specific date with AI-powered optimization.
Examples:
  neon schedule "Complete project" "2025-01-20"
  neon schedule "Meeting" "tomorrow"
  neon schedule "Review" "next friday"`,
	Args: cobra.RangeArgs(1, 2),
	Run: func(cmd *cobra.Command, args []string) {
		description := args[0]
		var targetDate time.Time
		var err error

		if len(args) > 1 {
			targetDate, err = parseDate(args[1])
			if err != nil {
				errorStyle := lipgloss.NewStyle().
					Foreground(styles.GetError()).
					Bold(true).
					Render(fmt.Sprintf("❌ Invalid date format: %v", err))
				fmt.Println(errorStyle)
				return
			}
		} else {
			// Use AI to suggest optimal date (simplified for now)
			targetDate = time.Now().AddDate(0, 0, 1) // Tomorrow
		}

		// Initialize calendar
		cal := calendar.New()
		loadTasksIntoCalendar(cal)

		// Create task with date
		task := createTaskWithDate(description, targetDate)
		
		// Add to calendar (and storage)
		cal.AddTask(task)
		
		// Show success with streaming
		successMsg := fmt.Sprintf("📅 Task scheduled for %s", targetDate.Format("2006-01-02"))
		utils.StreamWithTypingEffect(successMsg, styles.GetSuccess())
		fmt.Println()

		// Show calendar preview around the scheduled date
		renderer := calendar.NewRenderer(styles.GetTheme())
		cal.SelectedDate = targetDate
		cal.CurrentDate = targetDate
		
		fmt.Println("📋 Calendar Preview:")
		fmt.Println(renderer.RenderMonth(cal))
	},
}

var todayCmd = &cobra.Command{
	Use:   "today",
	Short: "📅 Show today's tasks and schedule",
	Long:  "Display all tasks, events, and schedule for today with AI insights",
	Run: func(cmd *cobra.Command, args []string) {
		// Initialize calendar
		cal := calendar.New()
		loadTasksIntoCalendar(cal)

		// Check AI status
		status := utils.CheckAIStatus()
		fmt.Print("AI Status: ")
		utils.StreamStatusWithIndicator(status)
		fmt.Println()

		// Get today's details
		today := time.Now()
		dayDetails := cal.GetDayDetails(today)
		renderer := calendar.NewRenderer(styles.GetTheme())

		// Show today's header
		header := lipgloss.NewStyle().
			Foreground(styles.GetSuccess()).
			Bold(true).
			Padding(1, 2).
			BorderStyle(lipgloss.DoubleBorder()).
			BorderForeground(styles.GetSuccess()).
			Align(lipgloss.Center).
			Render(fmt.Sprintf("🔥 TODAY - %s", today.Format("Monday, January 2, 2006")))
		fmt.Println(header)
		fmt.Println()

		// Show tasks
		if len(dayDetails.Tasks) > 0 {
			taskHeader := lipgloss.NewStyle().
				Foreground(styles.GetAccent()).
				Bold(true).
				Render("📋 TODAY'S TASKS")
			fmt.Println(taskHeader)
			
			for _, task := range dayDetails.Tasks {
				taskIndicator := dayDetails.GetPriorityIndicator()
				taskStyle := lipgloss.NewStyle().
					Foreground(calendar.GetPriorityColor(task.Priority, styles.GetTheme())).
					Padding(0, 2).
					Render(fmt.Sprintf("%s %s", taskIndicator, task.Description))
				fmt.Println(taskStyle)
			}
			fmt.Println()
		} else {
			noTasksMsg := lipgloss.NewStyle().
				Foreground(styles.GetWarning()).
				Italic(true).
				Render("✨ No tasks scheduled for today - enjoy your free time!")
			fmt.Println(noTasksMsg)
			fmt.Println()
		}

		// Show upcoming and overdue
		upcoming := cal.GetUpcomingTasks()
		overdue := cal.GetOverdueTasks()

		if len(upcoming) > 0 {
			upcomingHeader := lipgloss.NewStyle().
				Foreground(styles.GetAccent()).
				Bold(true).
				Render("⚡ UPCOMING (7 days)")
			fmt.Println(upcomingHeader)
			
			for _, task := range upcoming[:min(3, len(upcoming))] {
				daysUntil := int(task.Deadline.Sub(today).Hours() / 24)
				taskStyle := lipgloss.NewStyle().
					Foreground(calendar.GetPriorityColor(task.Priority, styles.GetTheme())).
					Render(fmt.Sprintf("• %s (in %d days)", task.Description, daysUntil))
				fmt.Println(taskStyle)
			}
			fmt.Println()
		}

		if len(overdue) > 0 {
			overdueHeader := lipgloss.NewStyle().
				Foreground(styles.GetError()).
				Bold(true).
				Render("❌ OVERDUE")
			fmt.Println(overdueHeader)
			
			for _, task := range overdue[:min(3, len(overdue))] {
				daysOverdue := int(today.Sub(*task.Deadline).Hours() / 24)
				taskStyle := lipgloss.NewStyle().
					Foreground(styles.GetError()).
					Render(fmt.Sprintf("• %s (%d days overdue)", task.Description, daysOverdue))
				fmt.Println(taskStyle)
			}
			fmt.Println()
		}

		// AI insights
		aiInsight := generateTodayInsight(dayDetails, upcoming, overdue)
		insightStyle := lipgloss.NewStyle().
			Foreground(styles.GetForeground()).
			BorderStyle(lipgloss.RoundedBorder()).
			BorderForeground(styles.GetAccent()).
			Padding(1).
			Render(fmt.Sprintf("🤖 AI Insight: %s", aiInsight))
		fmt.Println(insightStyle)
	},
}

// Helper functions
func loadTasksIntoCalendar(cal *calendar.Calendar) {
	// Load existing tasks from storage
	store := store.New(utils.GetStoragePath())
	engine := engine.New(store)
	
	tasks, err := engine.ListTasks("all")
	if err != nil {
		return
	}
	
	// Add tasks to calendar
	for _, task := range tasks {
		// Convert to calendar task (this would need proper conversion)
		calTask := struct {
			Description string
			Status      string
			Priority    string
			CreatedAt   time.Time
			UpdatedAt   time.Time
			Deadline    time.Time
			Categories  []string
		}{
			Description: task.Description,
			Status:      task.Status,
			Priority:    task.Priority,
			CreatedAt:   task.CreatedAt,
			UpdatedAt:   task.CreatedAt, // Simplified
			Deadline:    time.Now(), // Placeholder - would use actual deadline
			Categories:  []string{},
		}
		
		// Add calendar task (simplified)
		cal.AddTask(calTask)
	}
}

func parseDate(dateStr string) (time.Time, error) {
	// Simple date parsing - in a real implementation, this would be more robust
	formats := []string{
		"2006-01-02",
		"2006-01-02 15:04",
		"Jan 2, 2006",
		"January 2, 2006",
	}
	
	for _, format := range formats {
		if date, err := time.Parse(format, dateStr); err == nil {
			return date, nil
		}
	}
	
	// Handle relative dates
	now := time.Now()
	switch dateStr {
	case "today", "now":
		return now, nil
	case "tomorrow":
		return now.AddDate(0, 0, 1), nil
	case "yesterday":
		return now.AddDate(0, 0, -1), nil
	case "next week":
		return now.AddDate(0, 0, 7), nil
	case "next friday":
		return nextWeekday(now, time.Friday), nil
	case "next monday":
		return nextWeekday(now, time.Monday), nil
	default:
		return time.Time{}, fmt.Errorf("unable to parse date: %s", dateStr)
	}
}

func nextWeekday(start time.Time, weekday time.Weekday) time.Time {
	daysUntil := int(weekday - start.Weekday())
	if daysUntil <= 0 {
		daysUntil += 7
	}
	return start.AddDate(0, 0, daysUntil)
}

func generateTodayInsight(day calendar.CalendarDay, upcoming, overdue []interface{}) string {
	totalTasks := len(day.Tasks)
	hasOverdue := len(overdue) > 0
	hasUpcoming := len(upcoming) > 0
	
	if totalTasks == 0 {
		return "Great day for planning ahead! Consider scheduling some important tasks."
	}
	
	if hasOverdue {
		return "You have overdue tasks - consider tackling those first to get back on track!"
	}
	
	if totalTasks > 5 {
		return "Busy day ahead! Focus on high-priority tasks and consider delegating if possible."
	}
	
	if hasUpcoming {
		return "Good balance today. Use your free time to prepare for upcoming tasks."
	}
	
	return "Perfect day to stay focused and make progress on your goals!"
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func init() {
	rootCmd.AddCommand(calendarCmd)
	rootCmd.AddCommand(scheduleCmd)
	rootCmd.AddCommand(todayCmd)
}